# Copy to .env and fill in:   cp .env.example .env
# Scripts read the real environment first, then .env (if present). .env is gitignored — never commit it.
# An empty value counts as unset: the step that needs it exits with "Missing required environment variable".
#
# Which step needs what (everything else runs with no credentials at all):
#   S3  assist_fetch        PIPELINE_CONTACT_EMAIL (User-Agent only)
#   S4  spec_extract        ANTHROPIC_API_KEY, SPEC_EXTRACT_MODEL          (--dry-run needs nothing)
#   S6  digikey_search      DIGIKEY_CLIENT_ID, DIGIKEY_CLIENT_SECRET       (--dry-run needs nothing)
#   S7  nexar_enrich        NEXAR_CLIENT_ID, NEXAR_CLIENT_SECRET + budget   (--dry-run needs nothing)
#   S10 usaspending_prices  PIPELINE_CONTACT_EMAIL (no API key exists)
#   S1, S2, S5, S8, S9, S11 — none.

# ---- Contact address used in User-Agent for polite fetching of government sources (S3, S10)
PIPELINE_CONTACT_EMAIL=you@example.com

# ---- Digi-Key Product Information API v4 (S6). 2-legged OAuth2 client credentials.
# Production app must be subscribed to "Product Information V4". Sandbox returns canned data.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Production: https://api.digikey.com   Sandbox: https://sandbox-api.digikey.com
DIGIKEY_BASE_URL=https://api.digikey.com

# ---- Nexar / Octopart (S7). Client credentials from portal.nexar.com.
# Optional: paste a portal access token to skip the identity server (Authorization: Bearer).
NEXAR_ACCESS_TOKEN=
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
# Hard ceilings enforced in code (matched parts, not calls). The counter lives in cache/nexar_usage.json.
NEXAR_LIFETIME_BUDGET=100
NEXAR_MAX_MPNS_PER_RUN=90
# Set to 0 if your Nexar plan does NOT include the Tech Specs add-on (lifecycleStatus, bestDatasheet).
NEXAR_PRO_FIELDS=1

# ---- LLM for spec extraction (S4). Anthropic Messages API via plain HTTPS.
ANTHROPIC_API_KEY=
# Confirm this model id is valid for your account before the precompute run.
SPEC_EXTRACT_MODEL=claude-sonnet-4-5

# ---- Optional overrides of where manually-downloaded raw files live
# PUBLOG_DIR=raw/publog
# QPL_DIR=raw/qpl
